# Runtime configuration for the production R2 signing adapter.
# Supply these as hosted secrets/settings; never embed them in browser code.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Enable only for a controlled initial setup, then disable new-space creation.
ALLOW_SPACE_CREATION=false

# Phase 2 preparation. Keep disabled until account/session routes and migration are released.
# Client secret belongs in Worker secrets, never in browser/public environment settings.
AUTH0_ENABLED=false
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
RELAY_APP_ORIGIN=https://relayalbums.com
# Explicitly set a total allocation budget before enabling My space creation (1 GiB per person).
# Zero disables new allocations; existing personal libraries retain their recorded quotas.
PERSONAL_STORAGE_BUDGET_BYTES=0
